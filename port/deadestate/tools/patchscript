#!/bin/bash
# First start patcher for Dead Estate (Demo), run by PortMaster's patcher screen from the launcher.
# Checks the player's data.win, runs gmtoolkit on it (ASTC textures into saves/textures, audio to
# 64 kbps OGG, GMLive patched out) and zips the result into deadestate.port next to the runner.
GAMEDIR="$PWD"
LOGFILE="patchlog.txt"
LOGERR="patcherr.txt"

rm -f "$GAMEDIR/$LOGERR"
# fd 3 is the patcher screen; PATCH_FAIL_MSG lines go there without landing in the log.
exec 3>&1
> "$GAMEDIR/$LOGFILE" && exec > >(tee "$GAMEDIR/$LOGFILE") 2>&1

emit_fail_msg() {
    echo "PATCH_FAIL_MSG:$1" >&3
    echo "$1"
    FAIL_MSG_SET=1
}

echo "GAMEDIR is set to: $GAMEDIR"

export DATADIR="$GAMEDIR/assets"
export SAVEDIR="$GAMEDIR/saves"
export DATAFILE="deadestate.port"
CONFIG="$GAMEDIR/tools/gmtoolkit.json"


# astcenc and the Vorbis encoder run one job per thread; 1 GB devices cannot hold many at once.
THREADS_FLAG=""
if [ "${DEVICE_RAM:-0}" -le 2 ]; then
    THREADS_FLAG="--threads 2"
fi

# Run the CPU at 80% while patching so passively cooled devices do not throttle or shut down.
ORIG_MAX_FREQS=""
thermal_setup() {
    for policy in /sys/devices/system/cpu/cpufreq/policy*; do
        [ -f "$policy/scaling_max_freq" ] || continue
        orig=$(cat "$policy/scaling_max_freq") || continue
        $ESUDO sh -c "echo $((orig * 8 / 10)) > '$policy/scaling_max_freq'" 2>/dev/null || true
        ORIG_MAX_FREQS="$ORIG_MAX_FREQS|$policy=$orig"
    done
}

thermal_restore() {
    local OLDIFS=$IFS; IFS='|'
    for entry in $ORIG_MAX_FREQS; do
        [ -z "$entry" ] && continue
        $ESUDO sh -c "echo ${entry#*=} > '${entry%=*}/scaling_max_freq'" 2>/dev/null || true
    done
    IFS=$OLDIFS
}

check_files() {
    for f in data.win audiogroup1.dat audiogroup2.dat; do
        if [ ! -f "$DATADIR/$f" ]; then
            emit_fail_msg "Missing assets/$f. Copy data.win, audiogroup1.dat and audiogroup2.dat from the Steam demo into ports/deadestate/assets."
            return 1
        fi
    done
    # Supported builds only: the runner and the GML patch match these.
    local md5 build
    md5=$(md5sum "$DATADIR/data.win" | cut -d' ' -f1)
    case "$md5" in
        b6000d999062ae36e35303741a3f2461) build="demo, Steam build 7634959" ;;
    esac
    if [ -z "$build" ]; then
        emit_fail_msg "Unsupported data.win (md5 $md5). This port supports the Dead Estate demo, Steam build 7634959."
        return 1
    fi
    echo "Found Dead Estate $build"
}

prepare_files() {
    mkdir -p "$SAVEDIR"
    rm -rf "$SAVEDIR/textures"
    # Everything else from the Steam folder is not needed on the device.
    find "$DATADIR" -type f \( -name "*.exe" -o -name "*.dll" -o -name "*.ini" -o -name "*.acf" \) -exec rm -f {} \;
    mv "$DATADIR/data.win" "$DATADIR/game.droid"
}

patch_datafile() {
    if ! "$GAMEDIR/tools/gmtoolkit.${DEVICE_ARCH}" "$DATADIR/game.droid" --config "$CONFIG" $THREADS_FLAG; then
        emit_fail_msg "gmtoolkit failed to patch the game data."
        return 1
    fi
}

# Add assets/ (game.droid and the audio groups) to the .port, which already holds the runner.
zip_archive() {
    local zip_out
    if zip_out=$(cd "$GAMEDIR" && "$controlfolder/7zzs.${DEVICE_ARCH}" a -tzip -aoa -mx=0 "$GAMEDIR/$DATAFILE" assets 2>&1); then
        rm -rf "$DATADIR"/*
    else
        echo "$zip_out"
        emit_fail_msg "Failed to add the game data to $DATAFILE."
        return 1
    fi
}

process_game() {
    echo "Checking files..."
    check_files || return 1
    prepare_files || return 1
    echo "Patching game data (this takes a while)..."
    thermal_setup
    patch_datafile
    rc=$?
    thermal_restore
    [ "$rc" -ne 0 ] && return 1
    echo "Packing..."
    zip_archive || return 1
}

if ! process_game; then
    [ -z "$FAIL_MSG_SET" ] && emit_fail_msg "Patching failed. Report on the PortMaster Discord with patcherr.txt."
    echo "Patching process failed!"
    mv "$LOGFILE" "$LOGERR"
    exit 1
fi
echo "Patching process complete!"
